# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# The public URL of the site. Use http://<server-ip> until you have a domain, then https://yourdomain.
# Baked in at build time: rebuild after changing it (docker compose up -d --build).
SITE_URL=http://203.0.113.10

# What Caddy listens for. ":80" = plain HTTP on the IP. Set to yourdomain.com for automatic HTTPS.
SITE_ADDRESS=:80

# Long random string (run: openssl rand -hex 32). Required.
SESSION_SECRET=

# Only used once People's stories and the admin review queue are switched on.
ADMIN_PASSWORD=

# Litestream backups to Cloudflare R2 (only with --profile backup).
# Endpoint looks like https://<account-id>.r2.cloudflarestorage.com
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
