# Where the SQLite file lives. Keep it on a persistent disk in production.
DATABASE_PATH=data/coldspot.db

# Admin panel at /admin
ADMIN_PASSWORD=change-me
# Any long random string. Signs the admin cookie and salts IP hashes.
SESSION_SECRET=replace-with-a-long-random-string

# Used for sitemap and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
