# Where the SQLite file lives. Keep it on a persistent disk in production.
DATABASE_PATH=data/coldspot.db

# Admin panel at /admin
ADMIN_PASSWORD=change-me
# Any long random string. Signs sign-in sessions and salts IP and admin-session hashes.
SESSION_SECRET=replace-with-a-long-random-string

# Google sign-in, needed to share stories and echo them. In Google Cloud Console, create an OAuth client
# ("Web application") with the redirect URI http://localhost:3000/api/auth/callback/google
# (and https://yourdomain.com/api/auth/callback/google in production).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Which proxy tells us the visitor's IP: none (local), cloudflare (production behind Cloudflare), or
# forwarded (one proxy that appends to x-forwarded-for). With none, IP rate limits are skipped.
TRUST_PROXY=none

# Cloudflare Turnstile on the share form (Cloudflare dashboard → Turnstile). Leave empty to skip the check.
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Used for sitemap and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
